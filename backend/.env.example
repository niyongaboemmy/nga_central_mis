# Environment Type: 'production' | 'development' | 'test'
ENV_TYPE=development

# Server Configuration
PORT=5001
NODE_ENV=development

# Puppeteer (PDF export) - only needed if the system Chrome isn't the one
# Puppeteer downloads itself. Leave unset locally; set on servers where the
# bundled Chromium download fails (see deploy.yml).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# JWT Configuration
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Google OAuth ("Sign in with Google") — OAuth 2.0 Client ID from
# Google Cloud Console > APIs & Services > Credentials. Must match the
# VITE_GOOGLE_CLIENT_ID used by the frontend (same client).
GOOGLE_CLIENT_ID=

# ============================================
# DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=ngarw_mis

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# Auth cookie domain - must match the domain the API is actually served
# from, or browsers silently reject the cookie (domain mismatch)
COOKIE_DOMAIN=localhost

# ============================================
# EMAIL
# ============================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=NGA Central MIS

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Log Level: info, warn, error (avoid debug in production)
LOG_LEVEL=info

# ============================================
# File storage - internal file-server service (../file-server), not FTP.
# The key must match FILE_SERVER_API_KEY in file-server/.env.
# ============================================
FILE_SERVER_URL=http://127.0.0.1:5004
FILE_SERVER_API_KEY=

# OpenAI Configuration (used as the preferred provider for AI DOCX lesson-plan extraction;
# falls through to the AI_PROVIDER_ORDER chain below if not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini Configuration
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI provider fallback — every AI feature in the app (lesson notes, lesson plans, scheme
# of work generation, curriculum import, mentorship insights, criteria matching) goes
# through this same chain via src/services/aiProviders. Set whichever keys you have.
AI_PROVIDER_ORDER=openai,gemini,groq,deepseek,glm
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GLM_API_KEY=
GLM_MODEL=glm-4.5-flash
# DeepSeek (paid, pay-as-you-go: https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Home (HOME_OVERVIEW_IMPLEMENTATION_PLAN.md §9): API base URLs of the apps
# that contribute to the post-login Home page. The MIS relays each app's
# POST /api/integration/home-summary with the user's own token. Leave a line
# empty to keep that app off Home.
HOME_APP_TASKMENTOR_URL=http://localhost:5002
HOME_APP_ATTENDANCE_URL=http://localhost:5171
HOME_APP_TUPO_URL=http://localhost:5190
# Per-app budget for one summary (ms)
HOME_APP_TIMEOUT_MS=8000
