e"},{"category":"General","content":"Internal linking"},{"category":"General","content":"Mobile responsiveness"},{"category":"General","content":"f. Google site verification"}],"instructor_name":"NIYONGABO Emmanuel","language_focus":"","lesson_date":"2026-03-05","level":"3","module_name":"","number_of_trainees":10,"outcomes":[{"activities":[],"code":"LO1","description":"Optimize websites for search engines","duration_minutes":0,"resources":[],"title":"Optimize websites for search engines"},{"activities":[],"code":"LO2","description":"Implement SEO best practices","duration_minutes":0,"resources":[],"title":"Implement SEO best practices"},{"activities":[],"code":"LO3","description":"Create and manage sitemaps","duration_minutes":0,"resources":[],"title":"Create and manage sitemaps"},{"activities":[],"code":"LO4","description":"Use proper metadata and keywords","duration_minutes":0,"resources":[],"title":"Use proper metadata and keywords"},{"activities":[],"code":"LO5","description":"Understand search ranking factors","duration_minutes":0,"resources":[],"title":"Understand search ranking factors"}],"school_year":"2025-26","sections":[{"duration_minutes":0,"learner_activities":"","resources":"No. Trainees: 10","section_type":"Development","trainer_activities":"Module (Code& Name): SPEWI302, Development of Web User Interface"},{"duration_minutes":0,"learner_activities":"","resources":"","section_type":"Development","trainer_activities":"Learning Outcomes"},{"duration_minutes":0,"learner_activities":"","resources":"","section_type":"Development","trainer_activities":"Objectives/Learning intentions: At the end of the session trainees should be able to LO1: Understand SEO concepts and search engine ranking factors LO2: Implement on-page SEO techniques LO3: Create and manage XML sitemaps LO4: Use SEO tools and analytics"},{"duration_minutes":20,"learner_activities":"","resources":"Resources SEO tools (Google Analytics, Search Console) Keyword research tools Text editor Web 