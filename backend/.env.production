# Environment Type: 'production' - MUST be set to use production settings
ENV_TYPE=production

# Server Configuration
PORT=5001
NODE_ENV=production

# Puppeteer (PDF export) - use the system Chrome installed on the EC2 box
# instead of Puppeteer's own bundled download (see deploy.yml)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# JWT Configuration
JWT_SECRET="7308b028438a178e9db0f3fc24abbb3ecc4db2c886538129a3b84703a5c8258e"
JWT_EXPIRES_IN=1h

# Google OAuth ("Sign in with Google") — OAuth 2.0 Client ID from
# Google Cloud Console > APIs & Services > Credentials. Must match the
# VITE_GOOGLE_CLIENT_ID used by the frontend (same client).
GOOGLE_CLIENT_ID=913204130540-5hrfp5ridotig5ebd7ar424vhecq8bab.apps.googleusercontent.com

# ============================================
# PRODUCTION DATABASE (local MySQL on the EC2 instance)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=mis_app
DB_PASSWORD="Mis#App2026!x9"
DB_NAME=ngarw_mis

# CORS Configuration
# taskmentor.amashuri.com is here so SSO (session checks, login) from that
# app's frontend to this API isn't blocked by the browser.
CORS_ORIGIN=https://mis.amashuri.com,https://amashuri.com,https://www.amashuri.com,https://taskmentor.amashuri.com
CORS_CREDENTIALS=true

# Auth cookie domain - must match the domain the API is actually served
# from, or browsers silently reject the cookie (domain mismatch)
COOKIE_DOMAIN=.amashuri.com

# ============================================
# PRODUCTION EMAIL
# ============================================
SMTP_HOST=mail.hackflix.net
SMTP_PORT=465
SMTP_USER=mis@nga.ac.rw
SMTP_PASS=NgaMisMailPas@90
EMAIL_FROM=mis@nga.ac.rw
EMAIL_FROM_NAME=NGA Central MIS

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Log Level: info, warn, error (avoid debug in production)
LOG_LEVEL=info

# ============================================
# File storage - internal file-server service (../file-server), not FTP.
# Loopback URL since both run on the same EC2 box; the key must match
# FILE_SERVER_API_KEY in file-server/.env.production.
# ============================================
FILE_SERVER_URL=http://127.0.0.1:5004
FILE_SERVER_API_KEY=f58810609b8ddd0e5693b1b7c8859e03e59a852439aa2e8f0bc08381c3b8afa4

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Gemini Configuration (used for AI-generated Scheme of Work)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
