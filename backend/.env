# Environment Type: 'development' or 'production'
ENV_TYPE=development

# Database Connection: 'local' or 'remote' - switch to connect to different databases
DB_CONNECTION=local

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=1h

# ============================================
# DEVELOPMENT DATABASE (Local)
# ============================================
# Only used when DB_CONNECTION=local
DB_HOST=localhost
DB_PORT=8889
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=nga_central_mis

# ============================================
# PRODUCTION DATABASE (Remote)
# Only used when DB_CONNECTION=remote
DB_HOST_REMOTE=mysql.uk.cloudlogin.co
DB_PORT_REMOTE=3306
DB_USERNAME_REMOTE=ngarw_mis
DB_PASSWORD_REMOTE=NgaMisDbPass@90
DB_NAME_REMOTE=ngarw_mis

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://nga.ac.rw
CORS_CREDENTIALS=true

# ============================================
# EMAIL - Using production mail server
# ============================================
SMTP_HOST=mail.hackflix.net
SMTP_PORT=465
SMTP_USER=mis@nga.ac.rw
SMTP_PASS=NgaMisMailPas@90
EMAIL_FROM=mis@nga.ac.rw
EMAIL_FROM_NAME=NGA Central MIS

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10

# Log Level: debug, info, warn, error
LOG_LEVEL=debug
