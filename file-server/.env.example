# Server Configuration
PORT=5004
NODE_ENV=development

# Storage root (relative to file-server/, outside dist/ so it survives
# rebuilds). Files are namespaced by caller under here, e.g.
# storage/nga_central_mis/... and storage/nga-task-mentor/...
STORAGE_ROOT=./storage

# Max upload size in bytes (50MB, matches the limit already enforced by
# the document upload endpoints in nga_central_mis/backend)
MAX_FILE_SIZE=52428800

# Shared secret required on every request via the X-API-Key header. This
# service has no other access control -- it trusts whichever backend holds
# this key to have already done its own permission checks before calling
# here. Must match FILE_SERVER_API_KEY in every consuming backend's env.
FILE_SERVER_API_KEY=change-me-to-a-long-random-string

# Only these origins may call the file-server directly from a browser
# (server-to-server calls from the backends aren't subject to CORS at all --
# this only matters if something is ever fetched cross-origin client-side).
CORS_ORIGIN=http://localhost:5173
